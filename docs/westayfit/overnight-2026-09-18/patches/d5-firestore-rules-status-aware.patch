+        && exists(/databases/$(database)/documents/wsfMemberships/$(groupId + '_' + request.auth.uid))
+        && get(/databases/$(database)/documents/wsfMemberships/$(groupId + '_' + request.auth.uid)).data.membershipStatus == 'active';
     }
 
