{
  "hosting": {
    "site": "westayfit-app",
    "public": "apps/westayfit/dist",
    "ignore": [
      "firebase.json",
      "firebase.westayfit.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/community/*/challenge", "destination": "/community/__dynamic/challenge.html" },
      { "source": "/community/*/members", "destination": "/community/__dynamic/members.html" },
      { "source": "/community/**", "destination": "/community/__dynamic.html" },
      { "source": "/join/**", "destination": "/join/__dynamic.html" },
      { "source": "/contribute/**", "destination": "/contribute/__dynamic.html" },
      { "source": "/display/**", "destination": "/display/__dynamic.html" },
      { "source": "/kiosk/**", "destination": "/kiosk/__dynamic.html" },
      { "source": "/station/**", "destination": "/station/__dynamic.html" },
      { "source": "/event/**", "destination": "/event/__dynamic.html" },
      { "source": "/queue/**", "destination": "/queue/__dynamic.html" },
      { "source": "/move/**", "destination": "/move/__dynamic.html" },
      { "source": "/combined/**", "destination": "/combined/__dynamic.html" }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
          { "key": "Content-Type", "value": "text/html; charset=utf-8" }
        ]
      },
      {
        "source": "/_expo/static/js/**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
          { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
        ]
      }
    ]
  }
}
