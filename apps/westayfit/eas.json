{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_WSF_ENV": "staging"
      },
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_WSF_ENV": "staging"
      },
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    }
  }
}
