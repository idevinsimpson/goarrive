{
  "name": "@goarrive/westayfit",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "EXPO_PUBLIC_BUILD_COMMIT=\"$(git rev-parse --short HEAD)\" EXPO_PUBLIC_WSF_BUILT_AT=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" expo export --platform web --clear && python3 ../../scripts/westayfit/inject_meta.py",
    "deploy:staging": "firebase hosting:channel:deploy staging --config ../../firebase.westayfit.json --expires 7d",
    "ts:check": "tsc --noEmit",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "firebase": "^11.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^7.25.0",
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "babel-preset-expo": "~54.0.12",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.2"
  }
}
