{
  "expo": {
    "name": "We Stay Fit",
    "slug": "westayfit",
    "scheme": "westayfit",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.westayfit.app"
    },
    "android": {
      "package": "com.westayfit.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
