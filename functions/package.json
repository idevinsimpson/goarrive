{
  "name": "goarrive-functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test:rules": "jest",
    "test:contract": "jest --config jest.contract.config.cjs"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/.."
    ],
    "testMatch": [
      "<rootDir>/../firestore.rules.test.ts"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ],
    "globals": {
      "ts-jest": {
        "diagnostics": false,
        "tsconfig": {
          "module": "commonjs",
          "esModuleInterop": true
        }
      }
    }
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "@google-cloud/tasks": "^6.2.1",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.0.0",
    "firebase-functions": "^4.9.0",
    "googleapis": "^171.4.0",
    "sharp": "^0.35.3",
    "stripe": "^20.4.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "private": true
}
